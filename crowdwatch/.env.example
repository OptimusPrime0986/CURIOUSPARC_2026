# Environment configuration & secrets for CrowdWatch
# Never commit the actual .env file with secrets into version control.

# External Alert Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=operator@crowdwatch.local

# Dashboard Security
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_secure_password
JWT_SECRET_KEY=change_this_super_secret_jwt_key_for_offline_auth

# Hardware & Models
USE_CUDA=false
CLIP_EBC_WEIGHTS_PATH=
DEPTH_ANYTHING_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf
